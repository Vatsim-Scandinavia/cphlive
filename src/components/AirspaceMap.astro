---
import { denmarkRegionPaths, ekch } from "../utils/denmarkMap";
---

<div
  class="relative h-full w-full overflow-hidden bg-event-navy"
  aria-hidden="true"
>
  <svg
    viewBox="0 0 720 440"
    class="h-full w-full"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="land-fill" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#43c6e7" stop-opacity="0.2"></stop>
        <stop offset="1" stop-color="#43c6e7" stop-opacity="0.06"></stop>
      </linearGradient>
      <radialGradient id="ekch-glow">
        <stop stop-color="#c8102e" stop-opacity="0.3"></stop>
        <stop offset="1" stop-color="#c8102e" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <g
      fill="url(#land-fill)"
      stroke="#43c6e7"
      stroke-opacity="0.82"
      stroke-width="1.5"
      stroke-linejoin="round"
    >
      {denmarkRegionPaths.map((path) => <path d={path} />)}
    </g>

    <circle cx={ekch.x} cy={ekch.y} r="54" fill="url(#ekch-glow)"></circle>
    <circle
      cx={ekch.x}
      cy={ekch.y}
      r="8"
      fill="#071425"
      stroke="#c8102e"
      stroke-width="2"></circle>
    <circle cx={ekch.x} cy={ekch.y} r="3" fill="#c8102e"></circle>

    <g font-family="Roboto, sans-serif">
      <text
        x={ekch.x + 15}
        y={ekch.y + 4}
        fill="#fff"
        font-size="12"
        font-weight="700"
        letter-spacing="1.3">EKCH</text
      >
    </g>
  </svg>
</div>
