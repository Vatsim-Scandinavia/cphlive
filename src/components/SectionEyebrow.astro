---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<p class="section-eyebrow">
  {label}
</p>

<style>
  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-event-red);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
</style>
