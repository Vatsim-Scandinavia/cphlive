---
import orbxLogo from "../assets/sponsors/orbx-wordmark-gold.svg";
import volantaLogo from "../assets/sponsors/volanta-wordmark-symbol-blue.svg";
import iniBuildsLogo from "../assets/sponsors/inibuilds-wordmark-white.svg";
import simNordLogo from "../assets/sponsors/simnord-wordmark-blue.png";
import SectionEyebrow from "./SectionEyebrow.astro";

const sponsors = [
  {
    name: "ORBX",
    logo: orbxLogo,
    href: "https://orbxdirect.com/",
    logoClass: "w-16 sm:w-24",
  },
  {
    name: "Volanta",
    logo: volantaLogo,
    href: "https://volanta.app/",
    logoClass: "w-28 sm:w-44",
  },
  {
    name: "iniBuilds",
    logo: iniBuildsLogo,
    href: "https://inibuilds.com/",
    logoClass: "w-28 sm:w-44",
  },
  {
    name: "SimNord",
    logo: simNordLogo,
    href: "https://www.simnord.com/",
    logoClass: "w-28 sm:w-44",
  },
];
---

<section
  id="sponsors"
  class="border-t border-white/10 bg-event-section text-white"
  aria-labelledby="sponsors-title"
>
  <div class="container mx-auto px-6 py-20 sm:px-10 lg:px-16">
    <SectionEyebrow label="Made possible by" />
    <h2 id="sponsors-title" class="mt-2 text-4xl font-semibold">
      Our sponsors
    </h2>
    <p class="mt-1 max-w-xl text-base leading-relaxed text-white/70">
      A huge thank you to our partners for helping bring Copenhagen Live to
      life.
    </p>

    <ul
      class="mt-8 grid grid-cols-2 gap-x-10 gap-y-14 lg:grid-cols-4 lg:gap-x-16"
      aria-label="Event sponsors"
    >
      {
        sponsors.map((sponsor) => (
          <li class="group grid min-h-24 place-items-center text-center sm:min-h-28">
            <a
              href={sponsor.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Visit ${sponsor.name} website`}
              class:list={[
                "flex scale-100 transform-gpu items-center justify-center transition-transform duration-200 ease-out will-change-transform group-hover:scale-105 focus-visible:scale-105 focus-visible:outline-2 focus-visible:outline-offset-6 focus-visible:outline-white motion-reduce:transition-none",
                sponsor.logoClass,
              ]}
            >
              <img
                src={sponsor.logo.src}
                alt={sponsor.name}
                class="h-auto w-full"
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
