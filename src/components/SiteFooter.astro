---
import Wordmark from "./Wordmark.astro";

const footerLinks = [
  { label: "The event", href: "/#event" },
  { label: "Pilot briefings", href: "/#pilots" },
  { label: "Competitions", href: "/#competitions" },
  { label: "Sponsors", href: "/#sponsors" },
];
---

<footer class="border-t border-white/10 bg-event-footer text-white">
  <div class="container mx-auto px-6 pt-16 pb-8 sm:px-10 sm:pt-20 lg:px-16">
    <div
      class="grid gap-12 pb-16 sm:grid-cols-2 lg:grid-cols-4 lg:gap-16 lg:pb-20"
    >
      <div class="lg:col-span-2">
        <a
          href="/"
          class="inline-flex min-h-11 items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          aria-label="Copenhagen Live 2026 home"
        >
          <Wordmark />
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/60">
          One airport. One room. A full day of Scandinavian aviation, brought to
          you by{" "}
          <a
            href="https://vatsim-scandinavia.org/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="VATSIM Scandinavia website (opens in a new tab)"
            class="font-medium text-white/70 underline decoration-white/30 underline-offset-4 transition-colors duration-200 ease-out hover:text-white focus-visible:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none"
            >VATSIM Scandinavia</a
          >.
        </p>
      </div>

      <nav aria-label="Footer navigation">
        <h2
          class="text-xs font-semibold tracking-widest text-white/60 uppercase"
        >
          Explore
        </h2>
        <ul class="mt-5 space-y-3">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-white/70 transition-colors duration-200 ease-out hover:text-white focus-visible:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2
          class="text-xs font-semibold tracking-widest text-white/60 uppercase"
        >
          Event details
        </h2>
        <dl class="mt-5 space-y-4 text-sm">
          <div>
            <dt class="text-white/60">Date</dt>
            <dd class="mt-1 font-medium">
              <time datetime="2026-09-05">5 September 2026</time>
            </dd>
          </div>
          <div>
            <dt class="text-white/60">Time</dt>
            <dd class="mt-1 font-medium">04:00–22:00z</dd>
          </div>
          <div>
            <dt class="text-white/60">Airport</dt>
            <dd class="mt-1 font-medium">Copenhagen / EKCH</dd>
          </div>
        </dl>
      </div>
    </div>

    <div
      class="flex flex-col gap-5 border-t border-white/10 pt-7 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© 2026 VATSIM Scandinavia. For flight simulation use only.</p>
      <a
        href="#top"
        class="group inline-flex w-fit items-center gap-3 font-medium text-white/70 transition-colors duration-200 ease-out hover:text-white focus-visible:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none"
      >
        Back to top
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-4 transition-transform duration-200 ease-out group-hover:-translate-y-0.5 group-focus-visible:-translate-y-0.5 motion-reduce:transition-none"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="square"
          stroke-linejoin="miter"
        >
          <path d="M12 19V5M7 10l5-5 5 5"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
