---
import BriefingPage from "../../components/BriefingPage.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { briefings, type Briefing } from "../../data/briefings";
import Layout from "../../layouts/Layout.astro";

interface Props {
  briefing: Briefing;
}

export function getStaticPaths() {
  return [
    {
      params: { briefing: "departure" },
      props: { briefing: briefings.departure },
    },
    {
      params: { briefing: "arrival" },
      props: { briefing: briefings.arrival },
    },
  ];
}

const { briefing } = Astro.props;
---

<Layout
  title={`${briefing.label} briefing | Copenhagen Live 2026`}
  description={`Prepare for your Copenhagen Live ${briefing.direction} with a step-by-step walkthrough of EKCH procedures and event operations.`}
>
  <SiteHeader slot="header" />
  <BriefingPage briefing={briefing} />
  <SiteFooter slot="footer" />
</Layout>
